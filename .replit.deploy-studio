# Drop-in deploy config for BioSync Studio (React 19 SPA, static).
# Activate: cp .replit.deploy-studio .replit
# Then click Deploy → Static in Replit UI.

modules = ["nodejs-20", "nix"]
# `pnpm install` prepended so a fresh Repl import (or branch pull) can resolve
# workspace deps like driver.js before Vite dev does import-analysis.
run = "pnpm install --frozen-lockfile && PORT=4310 BASE_PATH=/ pnpm --filter @workspace/biosync-studio dev"
hidden = [".config", "node_modules", "dist", ".cache", ".local", "test-results", "playwright-report"]

[nix]
channel = "stable-24_05"

[env]
PORT = "4310"
HOST = "0.0.0.0"
BASE_PATH = "/"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

# Keeps node_modules fresh after every `git pull` (belt-and-suspenders for run).
[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[deployment]
deploymentTarget = "static"
build = ["sh", "-c", "corepack enable && corepack prepare pnpm@9 --activate && pnpm install --frozen-lockfile && BASE_PATH=/ pnpm --filter @workspace/biosync-studio build"]
publicDir = "artifacts/biosync-studio/dist/public"

[[deployment.rewrites]]
from = "/*"
to = "/index.html"

[[ports]]
localPort = 4310
externalPort = 80
