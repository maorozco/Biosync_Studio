# BioSync Landing — environment variables
# Copy to .env.local and fill in real values for production.

# ----------------------------------------------------------------------
# API backend (optional). If empty, landing runs in MOCK MODE — form
# submits short-circuit with simulated success. Needed to persist real
# signups.
# ----------------------------------------------------------------------
VITE_API_URL=

# ----------------------------------------------------------------------
# Canonical site URL (for OG/hreflang). Defaults to window.location.origin
# if unset.
# ----------------------------------------------------------------------
VITE_SITE_URL=

# ----------------------------------------------------------------------
# Calendly link for 🟢 tier post-submit (Manuela's booking URL).
# ----------------------------------------------------------------------
VITE_CALENDLY_URL=https://calendly.com/manuela-orozco/biosync-feedback

# ----------------------------------------------------------------------
# Counter baseline — real count is always Math.max(realCount, this).
# Keeps the hero from showing "0 labs" before launch. Do NOT set above
# real signups post-launch.
# ----------------------------------------------------------------------
VITE_COUNTER_BASELINE=25

# ----------------------------------------------------------------------
# Plausible (optional analytics). Leave empty to disable.
# ----------------------------------------------------------------------
VITE_PLAUSIBLE_DOMAIN=
