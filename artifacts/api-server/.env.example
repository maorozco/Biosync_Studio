# BioSync api-server — environment variables
# Copy to .env (gitignored) and fill for prod. Empty = MOCK MODE (todo funciona local).

# ----------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------
PORT=3002
LOG_LEVEL=info

# ----------------------------------------------------------------------
# Database — Postgres. MOCK MODE si vacío (in-memory, datos no persisten).
# Requisito: CREATE EXTENSION vector; antes de `pnpm db:push`.
# ----------------------------------------------------------------------
DATABASE_URL=

# ----------------------------------------------------------------------
# LLM — elegí UNO de los dos:
#
# Opción A · OpenAI direct
# ----------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Opción B · Azure OpenAI (cuando tengan az login + deployments creados)
# ----------------------------------------------------------------------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBED_DEPLOYMENT=

# ----------------------------------------------------------------------
# CORS — lista de orígenes permitidos (separados por coma). Vacío = open (dev only).
# ----------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3101,https://bio-sync-stu.replit.app

# ----------------------------------------------------------------------
# Apify (para scraping manual Reddit). Usado por scripts/, no por el api-server.
# ----------------------------------------------------------------------
APIFY_API_KEY=
