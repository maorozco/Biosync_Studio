# BioSync api-server — environment variables
# Copy to .env (gitignored) and fill for prod. Empty = MOCK MODE (todo funciona local).

# ----------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------
PORT=3002
LOG_LEVEL=info

# ----------------------------------------------------------------------
# Database — Postgres. Opciones (en orden de preferencia 2026):
#   1. Neon (free 512 MB) → https://neon.tech · pgvector nativo
#   2. Replit DB (key-value) → apt si no necesitás SQL complejo
#   3. Supabase (free tier) → pgvector también
# MOCK MODE si vacío (in-memory, no persiste entre restarts).
# Requisito post-connect: CREATE EXTENSION vector; antes de `pnpm db:push`.
# ----------------------------------------------------------------------
DATABASE_URL=

# ----------------------------------------------------------------------
# LLM — OpenAI direct (default para Replit $20/mo · opcional, defaults a mock)
# Crear key en platform.openai.com. Costo esperado con prompt caching: $1-3/pitch,
# $10-40 en 90d beta. Si vacío → corpus offline + cache 10 pre-validadas (MOCK).
# ----------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Azure OpenAI (NO usar — no tenemos créditos. El código lo soporta por si
# algún día migramos, pero hoy vamos con OpenAI direct + Replit Secrets).
# ----------------------------------------------------------------------
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_CHAT_DEPLOYMENT=
# AZURE_OPENAI_EMBED_DEPLOYMENT=

# ----------------------------------------------------------------------
# CORS — lista de orígenes permitidos (separados por coma). Vacío = open (dev only).
# ----------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3101,https://bio-sync-stu.replit.app

# ----------------------------------------------------------------------
# Apify (para scraping manual Reddit). Usado por scripts/, no por el api-server.
# ----------------------------------------------------------------------
APIFY_API_KEY=
