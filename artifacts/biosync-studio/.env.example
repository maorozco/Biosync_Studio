# BioSync Studio frontend — env vars
# Copy to .env.local, fill as needed. Empty = MOCK MODE.

# API server base URL. Empty → client-side mock fallback (demo-safe).
# Local dev: http://localhost:3002
# Prod:      https://<azure-container-app-fqdn>
VITE_API_URL=

# Plausible analytics (optional)
VITE_PLAUSIBLE_DOMAIN=
